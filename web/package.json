    "test": "vitest run",
    "lint": "biome check src e2e",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.2.0",
    "motion": "^12.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "1.56.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "playwright-core": "1.56.0"
  }
