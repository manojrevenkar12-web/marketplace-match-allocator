{
  "name": "marketplace-match-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "dev": "npm run sync && vite",
    "build": "npm run sync && tsc --noEmit && vite build",
